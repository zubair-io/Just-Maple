{
  "name": "@maple/shared",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    },
    "./utils/slug": {
      "types": "./dist/utils/slug.d.ts",
      "import": "./dist/utils/slug.js"
    },
    "./local": {
      "types": "./dist/local/index.d.ts",
      "import": "./dist/local/index.js"
    }
  },
  "scripts": {
    "build": "bunx tsc",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.48",
    "markdown-it": "^14.1.1",
    "yaml": "^2.8.2",
    "@openuidev/lang-core": "0.4.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "typescript": "^5.3.0"
  }
}
