{
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "just-maple": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/just-maple",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "*-OFL.txt",
                "input": "projects/maple-common/src/assets/fonts",
                "output": "licenses"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "baseHref": "./",
            "optimization": {
              "scripts": true,
              "styles": {
                "minify": true,
                "inlineCritical": false
              },
              "fonts": false
            },
            "outputHashing": "all"
          },
          "configurations": {
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "just-maple:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest"
          }
        }
      }
    },
    "maple-common": {
      "projectType": "library",
      "root": "projects/maple-common",
      "sourceRoot": "projects/maple-common/src",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/maple-common/ng-package.json",
            "tsConfig": "projects/maple-common/tsconfig.lib.json"
          }
        }
      }
    }
  }
}
