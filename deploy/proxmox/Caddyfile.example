# Just Maple - Caddy Reverse Proxy Configuration
# Copy to Caddyfile and edit your domain

maple.yourdomain.com {
    # Automatic HTTPS via Let's Encrypt

    # Proxy all requests to the API
    reverse_proxy api:7071 {
        # Health checks
        health_uri /api/health
        health_interval 30s
        health_timeout 5s
    }

    # Optional: Enable compression
    encode gzip

    # Optional: Security headers
    header {
        # HSTS
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # Prevent clickjacking
        X-Frame-Options "SAMEORIGIN"
        # Prevent MIME sniffing
        X-Content-Type-Options "nosniff"
        # XSS protection
        X-XSS-Protection "1; mode=block"
    }
}

# Redirect www to non-www (optional)
www.maple.yourdomain.com {
    redir https://maple.yourdomain.com{uri} permanent
}
