# Just Maple - Proxmox Self-Hosting Environment Variables
# Copy this file to .env and configure the values

# ===========================================
# REQUIRED CONFIGURATION
# ===========================================

# JWT Secret - MUST be changed in production
# Generate with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-secure-random-string

# WebAuthn/Passkey Configuration
# RP_ID must match your domain (no protocol, no port)
RP_NAME=Just Maple
RP_ID=maple.yourdomain.com
ORIGIN=https://maple.yourdomain.com

# ===========================================
# OPTIONAL SERVICES
# ===========================================

# Gravatar API Key (for user avatars)
# Get from: https://gravatar.com/developers
# GRAVATAR_KEY=

# Azure Blob Storage (for profile pictures)
# HORNBEAM=

# Email Service (Azure Communication Services)
# AZURE_COMMUNICATION_CONNECTION_STRING=
# EMAIL_FROM=noreply@yourdomain.com

# Push Notifications
# PAPERBARK_URL=
# PAPERBARK_API_KEY=

# ===========================================
# ADVANCED OPTIONS
# ===========================================

# Watchtower Notifications (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Custom update interval (seconds, default 86400 = 24 hours)
# WATCHTOWER_POLL_INTERVAL=86400
