# Just Maple - ACR Deployment with External MongoDB/Redis
# Copy to .env and configure

# ===========================================
# YOUR EXISTING INFRASTRUCTURE
# ===========================================

# MongoDB connection string (your existing instance)
MONGODB_URI=mongodb://your-mongodb-host:27017/justmaple

# Redis connection string (your existing instance)
REDIS_URL=redis://your-redis-host:6379

# ===========================================
# REQUIRED CONFIGURATION
# ===========================================

# JWT Secret - MUST be changed in production
# Generate with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-secure-random-string

# WebAuthn/Passkey Configuration
RP_NAME=Just Maple
RP_ID=maple.yourdomain.com
ORIGIN=https://maple.yourdomain.com

# ===========================================
# OPTIONAL SERVICES
# ===========================================

# Gravatar API Key
# GRAVATAR_KEY=

# Azure Blob Storage (profile pictures)
# HORNBEAM=

# Email (Azure Communication Services)
# AZURE_COMMUNICATION_CONNECTION_STRING=
# EMAIL_FROM=noreply@yourdomain.com

# Push Notifications
# PAPERBARK_URL=
# PAPERBARK_API_KEY=
