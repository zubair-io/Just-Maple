{
  "name": "@maple/mcp",
  "version": "0.2.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "maple-mcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "dev:remote": "bun run --watch src/remote.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "build:remote": "bun build src/remote.ts --outdir dist --target bun",
    "start": "bun run src/index.ts",
    "start:remote": "bun run src/remote.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/jwt": "^1.4.0",
    "@maple/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "elysia": "^1.4.22",
    "mongodb": "^6.0.0",
    "yjs": "^13.6.29",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.0"
  }
}
