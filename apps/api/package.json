{
  "name": "@maple/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "bun run --cwd ../../packages/shared build",
    "dev": "PORT=8081 bun run --watch src/index.ts",
    "dev:e2e": "node src/start-e2e.mjs",
    "start": "PORT=8081 bun run --watch src/index.ts",
    "build": "bun run --cwd ../../packages/shared build && bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:token": "bun scripts/dev-token.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.76",
    "@anthropic-ai/sdk": "^0.71.2",
    "@azure/storage-blob": "^12.29.1",
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/jwt": "^1.2.0",
    "@maple/shared": "workspace:*",
    "@parse/node-apn": "^6.0.1",
    "@simplewebauthn/server": "^13.2.2",
    "@types/markdown-it": "^14.1.2",
    "@types/sharp": "^0.32.0",
    "@types/ws": "^8.18.1",
    "ajv": "^8.17.1",
    "axios": "^1.13.2",
    "csvtojson": "^2.0.14",
    "dotenv": "^17.2.3",
    "elysia": "^1.2.0",
    "ioredis": "^5.9.2",
    "jose": "^6.1.3",
    "markdown-it": "^14.1.0",
    "mongodb": "^6.0.0",
    "prosemirror-collab": "^1.3.1",
    "prosemirror-transform": "^1.10.5",
    "sharp": "^0.34.5",
    "ws": "^8.19.0",
    "yjs": "^13.6.29",
    "@openuidev/lang-core": "0.4.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.1.3",
    "@analogjs/vitest-angular": "^2.1.3",
    "@types/bun": "latest",
    "jsdom": "^27.3.0",
    "mongodb-memory-server": "^10.4.1",
    "typescript": "^5.3.0"
  }
}
