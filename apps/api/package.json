{
  "name": "@maple/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "bun run --cwd ../../packages/shared build",
    "dev": "bun run --watch src/index.ts",
    "dev:e2e": "bun run --watch src/index-e2e.ts",
    "start": "bun run src/index.ts",
    "build": "bun run --cwd ../../packages/shared build && bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:gravatar": "bun run scripts/migrate-gravatar-profiles.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.76",
    "@azure/communication-email": "^1.1.0",
    "@azure/storage-blob": "^12.29.1",
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/jwt": "^1.2.0",
    "@maple/shared": "workspace:*",
    "@parse/node-apn": "^6.0.1",
    "@simplewebauthn/server": "^13.2.2",
    "@types/markdown-it": "^14.1.2",
    "elysia": "^1.2.0",
    "lib0": "^0.2.117",
    "markdown-it": "^14.1.0",
    "mongodb": "^6.0.0",
    "prosemirror-model": "^1.25.4",
    "prosemirror-state": "^1.4.4",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.28"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.1.3",
    "@analogjs/vitest-angular": "^2.1.3",
    "@types/bun": "latest",
    "jsdom": "^27.3.0",
    "mongodb-memory-server": "^10.4.1",
    "typescript": "^5.3.0"
  }
}
