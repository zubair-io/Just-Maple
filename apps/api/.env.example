# Example Environment Variables for Local Development
# Copy this file to .env and fill in your actual values

# Gravatar API Key (optional - get from https://gravatar.com/developers)
GRAVATAR_KEY=your-gravatar-api-key-here

# MongoDB Connection
MONGODB_URI=mongodb://192.168.0.244:27017/justmaple

# JWT Secret (change in production)
JWT_SECRET=dev-secret-change-in-production

# Azure Blob Storage (Hornbeam - for profile pictures)
# Get connection string from Azure Portal
HORNBEAM=your-azure-blob-connection-string-here

# WebAuthn/Passkey Config
RP_NAME=Just Maple
RP_ID=localhost
ORIGIN=http://localhost:4200

# SignalR Config (for production realtime messaging)
USE_SIGNALR=false
# SIGNALR_SERVICE_URL=your-signalr-url
# SIGNALR_SERVICE_KEY=your-signalr-key

# Paperbark (push notification relay service)
PAPERBARK_URL=https://paperbark.justmaple.app
# PAPERBARK_API_KEY=your-paperbark-api-key

# APNs Config (for direct push in production)
# APNS_KEY_ID=your-apns-key-id
# APNS_TEAM_ID=your-apns-team-id
# APNS_KEY=your-apns-p8-key-content
# APNS_BUNDLE_ID=com.just.maple.JapaneseMaple
# APNS_PRODUCTION=false
