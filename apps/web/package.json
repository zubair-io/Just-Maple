{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "bun run --cwd ../../packages/shared build",
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "start:signalr": "ng serve --configuration signalr-local --host 0.0.0.0 --port 4200",
    "build": "bun run --cwd ../../packages/shared build && ng build",
    "build:paperbark": "bun run --cwd ../../packages/shared build && ng build --configuration paperbark",
    "build:production": "bun run --cwd ../../packages/shared build && ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^19.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@angular/service-worker": "^21.0.5",
    "@maple/shared": "workspace:*",
    "@microsoft/signalr": "^10.0.0",
    "@ngneat/elf": "^2.5.1",
    "@ngneat/elf-entities": "^5.0.2",
    "@simplewebauthn/browser": "^13.2.2",
    "@tiptap/core": "^3.14.0",
    "@tiptap/extension-collaboration": "^3.14.0",
    "@tiptap/extension-collaboration-cursor": "^2.26.2",
    "@tiptap/extension-document": "3.14.0",
    "@tiptap/extension-dropcursor": "3.14.0",
    "@tiptap/extension-gapcursor": "3.14.0",
    "@tiptap/extension-heading": "3.14.0",
    "@tiptap/extension-highlight": "3.14.0",
    "@tiptap/extension-image": "3.14.0",
    "@tiptap/extension-mention": "^3.14.0",
    "@tiptap/extension-paragraph": "3.14.0",
    "@tiptap/extension-placeholder": "3.14.0",
    "@tiptap/extension-task-item": "3.14.0",
    "@tiptap/extension-task-list": "3.14.0",
    "@tiptap/extension-typography": "3.14.0",
    "@tiptap/pm": "^3.14.0",
    "@tiptap/starter-kit": "^3.14.0",
    "@tiptap/suggestion": "^3.14.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "logrocket": "^11.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.28"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.1.3",
    "@analogjs/vitest-angular": "^2.1.3",
    "@angular/build": "^21.0.3",
    "@angular/cli": "^21.0.3",
    "@angular/compiler-cli": "^21.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "jsdom": "^27.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.2",
    "vite": "^7.2.7",
    "vitest": "^4.0.8"
  }
}
