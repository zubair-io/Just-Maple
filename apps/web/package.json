{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "bun run --cwd ../../packages/shared build",
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "start:signalr": "ng serve --configuration signalr-local --host 0.0.0.0 --port 4200",
    "build": "bun run --cwd ../../packages/shared build && ng build",
    "build:paperbark": "bun run --cwd ../../packages/shared build && ng build --configuration paperbark",
    "build:production": "bun run --cwd ../../packages/shared build && ng build --configuration production",
    "build:e2e": "bun run --cwd ../../packages/shared build && ng build --configuration e2e",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.1.1",
    "@angular/cdk": "^19.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@angular/service-worker": "^21.0.5",
    "@huggingface/transformers": "^3.8.1",
    "@maple/shared": "workspace:*",
    "@ngneat/elf": "^2.5.1",
    "@ngneat/elf-entities": "^5.0.2",
    "@simplewebauthn/browser": "^13.2.2",
    "@tiptap/core": "^3.15.3",
    "@tiptap/extension-bubble-menu": "^3.18.0",
    "@tiptap/extension-code-block-lowlight": "^3.18.0",
    "@tiptap/extension-collaboration": "^3.15.3",
    "@tiptap/extension-collaboration-cursor": "3.0.0-next.6",
    "@tiptap/extension-document": "^3.15.3",
    "@tiptap/extension-drag-handle": "^3.15.3",
    "@tiptap/extension-dropcursor": "^2.11.5",
    "@tiptap/extension-gapcursor": "^2.11.5",
    "@tiptap/extension-heading": "^3.13.0",
    "@tiptap/extension-highlight": "^2.11.5",
    "@tiptap/extension-image": "^2.11.5",
    "@tiptap/extension-mention": "^3.14.0",
    "@tiptap/extension-placeholder": "^3.15.3",
    "@tiptap/extension-table": "^3.15.3",
    "@tiptap/extension-table-cell": "^3.15.3",
    "@tiptap/extension-table-header": "^3.15.3",
    "@tiptap/extension-table-row": "^3.15.3",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-typography": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
