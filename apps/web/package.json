{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "bun run --cwd ../../packages/shared build",
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "dev": "bun run --cwd ../../packages/shared build && vite",
    "start:vite": "bun run dev",
    "start:signalr": "ng serve --configuration signalr-local --host 0.0.0.0 --port 4200",
    "build": "bun run --cwd ../../packages/shared build && ng build",
    "build:vite": "bun run --cwd ../../packages/shared build && vite build",
    "build:paperbark": "bun run --cwd ../../packages/shared build && ng build --configuration paperbark",
    "build:production": "bun run --cwd ../../packages/shared build && ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "preview": "vite preview"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^19.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@angular/service-worker": "^21.0.5",
    "@automerge/automerge": "^3.2.1",
    "@automerge/automerge-repo": "^2.5.1",
    "@automerge/automerge-repo-network-websocket": "^2.5.1",
    "@automerge/automerge-repo-storage-indexeddb": "^2.5.1",
    "@automerge/prosemirror": "^0.1.0",
    "@maple/shared": "workspace:*",
    "@microsoft/signalr": "^10.0.0",
    "@ngneat/elf": "^2.5.1",
    "@ngneat/elf-entities": "^5.0.2",
    "@simplewebauthn/browser": "^13.2.2",
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-document": "^2.11.5",
    "@tiptap/extension-dropcursor": "^2.11.5",
    "@tiptap/extension-gapcursor": "^2.11.5",
    "@tiptap/extension-heading": "^3.13.0",
    "@tiptap/extension-highlight": "^2.11.5",
    "@tiptap/extension-image": "^2.11.5",
    "@tiptap/extension-mention": "^3.14.0",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-typography": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "@tiptap/suggestion": "^3.14.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "logrocket": "^11.0.0",
    "prosemirror-collab": "^1.3.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.10.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.1.3",
    "@analogjs/vitest-angular": "^2.1.3",
    "@angular/build": "^21.0.3",
    "@angular/cli": "^21.0.3",
    "@angular/compiler-cli": "^21.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "jsdom": "^27.3.0",
    "sass": "^1.97.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.2.7",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^4.0.8"
  }
}
