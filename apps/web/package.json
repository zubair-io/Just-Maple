    "@tiptap/suggestion": "^3.14.0",
    "@types/d3": "^7.4.3",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "d3": "^7.9.0",
    "logrocket": "^11.0.0",
    "lowlight": "^3.3.0",
    "marked": "^17.0.1",
    "perfect-freehand": "^1.2.2",
    "prosemirror-collab": "^1.3.1",
