{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ],
        "urls": [
          "https://lego.justmaple.app/**",
          "https://fonts.sandbox.google.com/**",
          "https://fonts.googleapis.com/**",
          "https://hornbeam.justmaple.app/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "paperbark",
      "urls": [
        "https://tatarian.justmaple.app/*",
        "https://paperbark.justmaple.app/*"
      ],
      "cacheConfig": {
        "maxSize": 1000,
        "maxAge": "1d",
        "strategy": "freshness",
        "timeout": "90s"
      }
    }
  ]
}