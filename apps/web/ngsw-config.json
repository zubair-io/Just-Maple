{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"],
        "urls": [
          "https://lego.justmaple.app/**",
          "https://fonts.sandbox.google.com/**",
          "https://fonts.googleapis.com/**",
          "https://hornbeam.justmaple.app/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-static",
      "urls": ["/api/auth/me", "/api/tags", "/api/lego"],
      "cacheConfig": {
        "maxSize": 100,
        "maxAge": "1h",
        "strategy": "freshness",
        "timeout": "10s"
      }
    },
    {
      "name": "api-dynamic",
      "urls": ["/api/papers*", "/api/messages*", "/api/notes*"],
      "cacheConfig": {
        "maxSize": 500,
        "maxAge": "5m",
        "strategy": "freshness",
        "timeout": "5s"
      }
    }
  ]
}
