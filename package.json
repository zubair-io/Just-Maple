{
  "name": "just-maple",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run build:shared && (bun run dev:api & bun run dev:web)",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web start",
    "dev:e2e": "bun run build:shared && (bun run --cwd apps/api dev:e2e & bun run dev:web)",
    "build": "bun run build:shared && bun run build:api && bun run build:web",
    "build:shared": "bun run --cwd packages/shared build",
    "build:api": "bun run --cwd apps/api build",
    "build:web": "bun run --cwd apps/web build",
    "build:web:paperbark": "bun run --cwd apps/web build:paperbark",
    "build:web:production": "bun run --cwd apps/web build:production",
    "typecheck": "bun run --cwd packages/shared tsc --noEmit && bun run --cwd apps/web tsc -p tsconfig.app.json --noEmit",
    "test": "bun run test:api",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:api": "cd apps/api && vitest run",
    "test:web": "cd apps/web && vitest run",
    "test:shared": "cd packages/shared && vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@vitest/coverage-v8": "^4.0.15",
    "playwright": "^1.57.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "mongodb": "^7.0.0",
    "nanoid": "^5.1.6",
    "prettier": "^3.7.4",
    "yjs": "^13.6.29"
  }
}
