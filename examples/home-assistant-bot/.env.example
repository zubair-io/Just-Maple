# Just Maple API URL
API_URL=http://localhost:3000

# Your bot's token (get this when creating a custom bot)
BOT_TOKEN=bot_your_token_here

# Your bot's webhook secret (shown once when creating the bot)
WEBHOOK_SECRET=your_webhook_secret_here

# Port for this bot server
PORT=3002

# Home Assistant Configuration
HA_URL=http://homeassistant.local:8123
HA_ACCESS_TOKEN=your_long_lived_access_token

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Memo Editing — Daily Summary
# The page ID (UUID) of the memo document where the bot writes its daily HA summary.
# Create a memo page in Just Maple and copy its ID from the URL.
# The bot must have memos.read + memos.write permissions.
SUMMARY_PAGE_ID=

# Hour (0-23) at which the daily summary is generated. Default: 7 (7:00 AM local time)
SUMMARY_CRON_HOUR=7

# Anomaly Detection
# Page ID (UUID) of the memo where anomaly alerts are logged (all severities).
# Every cycle the bot rewrites this memo with new alerts prepended.
ALERTS_PAGE_ID=

# Page ID (UUID) of the chat page where urgent/attention alerts are posted.
# Only URGENT and ATTENTION events send a chat message; FYI goes to memo only.
ALERTS_CHAT_PAGE_ID=

# How often (in minutes) to run anomaly detection. Default: 10
ANOMALY_INTERVAL_MIN=10
