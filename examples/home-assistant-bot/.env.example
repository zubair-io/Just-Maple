# Just Maple API URL
API_URL=http://localhost:3000

# Your bot's token (get this when creating a custom bot)
BOT_TOKEN=bot_your_token_here

# Your bot's webhook secret (shown once when creating the bot)
WEBHOOK_SECRET=your_webhook_secret_here

# Port for this bot server
PORT=3002

# Home Assistant Configuration
HA_URL=http://homeassistant.local:8123
HA_ACCESS_TOKEN=your_long_lived_access_token

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key
