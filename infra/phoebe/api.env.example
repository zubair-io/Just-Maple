NODE_ENV=production
HOST=0.0.0.0
PORT=7071
DATABASE_DRIVER=sqlite
DATABASE_PATH=/var/lib/just-maple/staging.sqlite
BUN_EXEC_PATH=/usr/local/bin/bun
SQLITE_WORKER_PATH=/opt/just-maple/current/sqlite-worker.js
LOCAL_STORAGE_PATH=/var/lib/just-maple/media
DISABLE_BACKGROUND_JOBS=true
SERVER_SEARCH_ENABLED=true
SEARCH_WORKER_SOCKET=/run/just-maple-search/worker.sock
RP_ID=localhost
RP_NAME=Just Maple staging
ORIGIN=http://localhost:7073
PASSKEY_ORIGINS=http://localhost:7073
CORS_ORIGINS=http://localhost:7073
REDIS_URL=
# Generate a fresh random JWT_SECRET in /etc/just-maple/api.env; never copy production secrets.
