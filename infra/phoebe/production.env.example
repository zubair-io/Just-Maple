# Retain the Azure JWT secret, passkey RP identity, APNs, OAuth and Azure media credentials.
# Never copy this example over a configured deployment. Fill INSTANCE_ID once and keep it stable.
NODE_ENV=production
HOST=127.0.0.1
PORT=7071
DATABASE_DRIVER=sqlite
DATABASE_PATH=/var/lib/just-maple/production.sqlite
BUN_EXEC_PATH=/usr/local/bin/bun
SQLITE_WORKER_PATH=/opt/just-maple/current/sqlite-worker.js
LOCAL_STORAGE_PATH=/var/lib/just-maple/media
PUBLIC_URL=https://phoebe.justmaple.app
LOCAL_URL=https://local.phoebe.justmaple.app
INSTANCE_ID=
ORIGIN=https://phoebe.justmaple.app
RP_ID=justmaple.app
RP_NAME=Just Maple
PASSKEY_ORIGINS=https://phoebe.justmaple.app,https://local.phoebe.justmaple.app,https://justmaple.app,https://www.justmaple.app
CORS_ORIGINS=https://phoebe.justmaple.app,https://local.phoebe.justmaple.app,https://justmaple.app,https://www.justmaple.app
DISABLE_BACKGROUND_JOBS=false
SERVER_SEARCH_ENABLED=true
SEARCH_WORKER_SOCKET=/run/just-maple-search/worker.sock
REDIS_URL=
